{
	"name": "@destination/astro-sanity-preview",
	"version": "1.0.0",
	"description": "Astro integration that serves Sanity draft previews to the Studio's Presentation tool from a server build on AWS Amplify.",
	"keywords": [
		"astro",
		"astro-integration",
		"sanity",
		"visual-editing",
		"aws-amplify"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wearedestination/astro-sanity-preview.git"
	},
	"bugs": {
		"url": "https://github.com/wearedestination/astro-sanity-preview/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./client": {
			"types": "./dist/client.d.mts",
			"default": "./dist/client.mjs"
		},
		"./studio": {
			"types": "./dist/studio.d.mts",
			"default": "./dist/studio.mjs"
		},
		"./VisualEditing.astro": "./components/VisualEditing.astro",
		"./middleware": "./dist/middleware.mjs",
		"./routes/enable": "./dist/routes/enable.mjs",
		"./routes/disable": "./dist/routes/disable.mjs",
		"./visual-editing": "./dist/visual-editing.mjs"
	},
	"files": [
		"dist",
		"components"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"build": "tsdown",
		"check": "biome check",
		"type-check": "tsc --noEmit",
		"test": "npm run build && vitest run",
		"prepublishOnly": "npm run build"
	},
	"peerDependencies": {
		"@sanity/astro": "^3.5.0 || ^4.0.0",
		"@sanity/client": "^8.0.0",
		"astro": "^7.0.0",
		"sanity": "^6.0.0"
	},
	"peerDependenciesMeta": {
		"sanity": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@sanity/astro": "^3.5.1",
		"@sanity/client": "^8.6.2",
		"@types/node": "^24.19.1",
		"astro": "^7.3.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sanity": "^6.15.0",
		"styled-components": "^6.5.3",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@sanity/preview-url-secret": "^4.1.5",
		"@sanity/visual-editing": "^6.1.1",
		"astro-aws-amplify": "^0.6.0"
	}
}
